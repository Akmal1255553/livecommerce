APP_NAME=LiveCommerce
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=uz
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sentry (Sprint 15) — leave empty to disable locally / in tests
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# PostgreSQL — Docker local (optional) OR Supabase (preferred, ADR-018)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=livecommerce
DB_USERNAME=livecommerce
DB_PASSWORD=secret
# Cloud (Supabase): set these instead / in Railway variables:
# DB_HOST=db.YOUR_PROJECT.supabase.co
# DB_PORT=6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
# DB_SSLMODE=require

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=livecommerce

# Redis — Docker local OR Railway Redis (ADR-018)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Cloud: REDIS_HOST / REDIS_PORT / REDIS_PASSWORD from Railway Redis plugin

# Mailpit (Docker service: mailpit)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@livecommerce.local"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO (Docker service: minio) — S3-compatible
# Cloud VOD: STORAGE_DRIVER=s3 + Supabase Storage endpoint (required when API and worker are separate containers)
STORAGE_DRIVER=s3
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123456
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=livecommerce
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://localhost:9000/livecommerce

# Video processing (FFmpeg on worker image)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# DB queue retry must exceed ProcessVideoPipelineJob::$timeout (600)
# DB_QUEUE_RETRY_AFTER=660

# JWT (Sprint 1)
JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=43200

# Streaming (Sprint 6)
STREAMING_PROVIDER=fake
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Push notifications (Sprint 2)
FCM_SERVER_KEY=

# Payment gateway (Sprint 7 / RC1)
# fake = instant paid (local/tests ONLY — blocked in production)
# local|click|payme|uzum = redirect + webhook/sandbox
PAYMENT_GATEWAY=local
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
# Mobile sandbox Pay/Cancel — keep false in production unless explicitly needed
PAYMENT_SANDBOX_ENABLED=true

# Click (PAYMENT_GATEWAY=click) — empty credentials → sandbox URL fallback
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET=
CLICK_RETURN_URL=

# Payme (PAYMENT_GATEWAY=payme)
PAYME_MERCHANT_ID=
PAYME_SECRET=

# Uzum (PAYMENT_GATEWAY=uzum)
UZUM_MERCHANT_ID=
UZUM_SECRET=
UZUM_CHECKOUT_URL=https://checkout.uzumbank.uz
UZUM_RETURN_URL=

# Bitcoin / NOWPayments (method=bitcoin; empty API key → sandbox address + fixed rate)
BITCOIN_API_KEY=
BITCOIN_API_URL=https://api.nowpayments.io/v1
BITCOIN_IPN_SECRET=
BITCOIN_IPN_CALLBACK_URL=
BITCOIN_SANDBOX_RATE_UZS=1200000000
# Fallback UZS per 1 USD when CoinGecko has no UZS rate (NOWPayments invoices are USD)
BITCOIN_UZS_PER_USD=12500
# Minimum USD equivalent for BTC invoices (NOWPayments rejects tiny amounts)
BITCOIN_MIN_USD=20
BITCOIN_SANDBOX_ADDRESS=bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh
BITCOIN_INVOICE_TTL_MINUTES=30

# SMS provider (Sprint 1)
SMS_PROVIDER=
SMS_API_KEY=

VITE_APP_NAME="${APP_NAME}"
