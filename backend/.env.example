APP_NAME=LiveCommerce
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=uz
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL — Docker local (optional) OR Supabase (preferred, ADR-018)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=livecommerce
DB_USERNAME=livecommerce
DB_PASSWORD=secret
# Cloud (Supabase): set these instead / in Railway variables:
# DB_HOST=db.YOUR_PROJECT.supabase.co
# DB_PORT=6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
# DB_SSLMODE=require

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=livecommerce

# Redis — Docker local OR Railway Redis (ADR-018)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# Cloud: REDIS_HOST / REDIS_PORT / REDIS_PASSWORD from Railway Redis plugin

# Mailpit (Docker service: mailpit)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@livecommerce.local"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO (Docker service: minio) — S3-compatible
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123456
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=livecommerce
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://localhost:9000/livecommerce

# JWT (Sprint 1)
JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=43200

# Streaming (Sprint 6)
STREAMING_PROVIDER=fake
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Push notifications (Sprint 2)
FCM_SERVER_KEY=

# Payment gateway (Sprint 7)
PAYMENT_GATEWAY=click
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=

# SMS provider (Sprint 1)
SMS_PROVIDER=
SMS_API_KEY=

VITE_APP_NAME="${APP_NAME}"
